# Kopie hiervan heet .env (install.sh maakt hem aan).

# Het grote model voor de chatsite en Home Assistant. Een MoE-model: slim als een 30B,
# maar per woord rekent het met ~3B, dus op DDR3 nog vlot (~6-9 woorden per seconde).
MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# Contextlengte in tokens. Langer = meer RAM en tragere eerste reactie.
CONTEXT=8192

# Spraakherkenning: small-int8 is snel en goed in het Nederlands; medium-int8 is beter maar ~3x trager.
WHISPER_MODEL=small-int8

# Nederlandse stem van Piper.
PIPER_STEM=nl_NL-mls-medium

# Token van de Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Create → Docker).
TUNNEL_TOKEN=
